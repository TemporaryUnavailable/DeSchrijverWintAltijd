{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rikken Scorecard Transfer v2",
  "type": "object",
  "required": ["version", "game", "derived"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "game": { "$ref": "#/$defs/game" },
    "derived": { "$ref": "#/$defs/derived" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "player": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "rulesSnapshot": {
      "type": "object",
      "required": ["systemId", "name", "revision", "kind", "verification", "values"],
      "additionalProperties": false,
      "properties": {
        "systemId": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["source-preset", "custom"] },
        "verification": { "enum": ["unverified", "confirmed"] },
        "values": { "$ref": "#/$defs/ruleValues" }
      }
    },
    "ruleValues": {
      "type": "object",
      "required": ["rikAfrik", "soloContracts", "twoPlayerMiserie", "verzaking"],
      "additionalProperties": false,
      "properties": {
        "rikAfrik": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": { "type": "integer" }
        },
        "soloContracts": {
          "type": "object",
          "required": ["abondance", "miserieOne", "miserieOpen", "thirteenTricks", "soloSlim"],
          "additionalProperties": false,
          "properties": {
            "abondance": { "type": "integer", "minimum": 3, "multipleOf": 3 },
            "miserieOne": { "type": "integer", "minimum": 3, "multipleOf": 3 },
            "miserieOpen": { "type": "integer", "minimum": 3, "multipleOf": 3 },
            "thirteenTricks": { "type": "integer", "minimum": 3, "multipleOf": 3 },
            "soloSlim": { "type": "integer", "minimum": 3, "multipleOf": 3 }
          }
        },
        "twoPlayerMiserie": { "type": "integer", "minimum": 1 },
        "verzaking": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["mode"],
              "additionalProperties": false,
              "properties": { "mode": { "const": "manual-only" } }
            }
          ]
        }
      }
    },
    "scoreChanges": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9a-fA-F-]{36}$" },
      "additionalProperties": { "type": "integer" }
    },
    "giftInput": {
      "oneOf": [
        {
          "type": "object",
          "required": ["contract", "rikkerIds", "tricksTakenByRikkers"],
          "additionalProperties": false,
          "properties": {
            "contract": { "enum": ["rik-afrik", "troel"] },
            "rikkerIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/uuid" } },
            "tricksTakenByRikkers": { "type": "integer", "minimum": 0, "maximum": 13 }
          }
        },
        {
          "type": "object",
          "required": ["contract", "soloistId", "success"],
          "additionalProperties": false,
          "properties": {
            "contract": { "enum": ["abondance", "miserie-one", "miserie-open", "13-slagen", "solo-slim"] },
            "soloistId": { "$ref": "#/$defs/uuid" },
            "success": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["contract", "miseriePlayerIds", "successes"],
          "additionalProperties": false,
          "properties": {
            "contract": { "const": "miserie-two" },
            "miseriePlayerIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/uuid" } },
            "successes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "boolean" } }
          }
        },
        {
          "type": "object",
          "required": ["contract", "mode"],
          "additionalProperties": false,
          "properties": {
            "contract": { "const": "verzaking" },
            "mode": { "const": "manual-only" }
          }
        },
        {
          "type": "object",
          "required": ["contract"],
          "additionalProperties": false,
          "properties": { "contract": { "const": "manual" } }
        }
      ]
    },
    "gift": {
      "type": "object",
      "required": ["id", "dealerId", "input", "scoreChanges", "entryMode"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "dealerId": { "$ref": "#/$defs/uuid" },
        "input": { "oneOf": [{ "$ref": "#/$defs/giftInput" }, { "type": "null" }] },
        "scoreChanges": { "$ref": "#/$defs/scoreChanges" },
        "entryMode": { "enum": ["automatic", "manual", "legacy-manual"] },
        "manualNote": { "type": "string" }
      }
    },
    "game": {
      "type": "object",
      "required": ["id", "name", "players", "rulesSnapshot", "gifts", "legacy", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "players": { "type": "array", "minItems": 4, "maxItems": 7, "items": { "$ref": "#/$defs/player" } },
        "rulesSnapshot": { "oneOf": [{ "$ref": "#/$defs/rulesSnapshot" }, { "type": "null" }] },
        "gifts": { "type": "array", "items": { "$ref": "#/$defs/gift" } },
        "legacy": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "legacy": { "const": true } }, "required": ["legacy"] },
          "then": { "properties": { "rulesSnapshot": { "type": "null" } } },
          "else": {
            "properties": {
              "players": { "minItems": 4, "maxItems": 5 },
              "rulesSnapshot": { "$ref": "#/$defs/rulesSnapshot" },
              "gifts": { "maxItems": 15 }
            }
          }
        }
      ]
    },
    "derived": {
      "type": "object",
      "required": ["totals", "recordedGifts", "giftLimit", "nextDealerId"],
      "additionalProperties": false,
      "properties": {
        "totals": { "$ref": "#/$defs/scoreChanges" },
        "recordedGifts": { "type": "integer", "minimum": 0 },
        "giftLimit": { "oneOf": [{ "type": "integer", "enum": [12, 15] }, { "type": "null" }] },
        "nextDealerId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] }
      }
    }
  }
}
